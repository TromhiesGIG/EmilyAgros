{
  "expo": {
    "name": "EmilyAgros",
    "slug": "emilyagros",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "emilyagros",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emilyagros.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.emilyagros.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "00ce8bdb-99e0-4363-a50e-e91a9ecee31d"
      }
    },
    "owner": "tromphiesgig",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-audio"
    ]
  }
}
